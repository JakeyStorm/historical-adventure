# Copy this file to .env on the server.
# :80 = initial HTTP preview through the server's public IP.
# For HTTPS set a real domain that already points to this server.
SITE_ADDRESS=:80
CADDY_CONFIG=Caddyfile
# For trusted HTTPS through a public IP: SITE_ADDRESS=<server IP>
# and CADDY_CONFIG=Caddyfile.ip (Let's Encrypt short-lived IP certificate).

# Keep the real key only in .env, never in dist or chat.
POLZA_API_KEY=
# Cumulative spending cap for jobs accepted by this installation.
POLZA_BUDGET_RUB=unlimited
POLZA_MAX_PRICE_PER_SECOND=10
POLZA_MAX_AUDIO_PRICE_PER_SECOND=15
# Private server/admin secret. Never sent to visitors.
GENERATION_PASSWORD=
# Let visitors create videos without entering an access code.
PUBLIC_GENERATION=true
PUBLIC_MAX_JOB_RUB=unlimited
PUBLIC_JOBS_PER_HOUR=2
# Set true only behind the bundled Caddy proxy, with app:3000 private.
TRUST_PROXY=true
# Set FFMPEG_PATH if ffmpeg is not on PATH (needed for automatic voice/video editing).
# FFMPEG_PATH=
